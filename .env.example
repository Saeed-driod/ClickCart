# ClickCart Environment Variables
# Neon Postgres Database URL (Free tier from https://neon.tech)
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="clickcart_super_secret_jwt_key_change_me_in_production_123456789"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (Free tier from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"

# Public Store Configuration
NEXT_PUBLIC_STORE_NAME="ClickCart"
NEXT_PUBLIC_CURRENCY_SYMBOL="₨"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"

# Optional Stripe Integration (Behind env flag)
ENABLE_STRIPE="false"
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
