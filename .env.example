# ClickCart Environment Variables
# MongoDB Atlas Database URL (Free tier from https://www.mongodb.com/cloud/atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.t65ki5x.mongodb.net/clickcart?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.t65ki5x.mongodb.net/clickcart?retryWrites=true&w=majority"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="clickcart_super_secret_jwt_key_change_me_in_production_123456789"
# Optional: override default admin password (default seeded password is Admin@123)
ADMIN_PASSWORD=""

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (Free tier from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"

# Public Store Configuration
NEXT_PUBLIC_SITE_URL="https://clickcarts.vercel.app"
NEXT_PUBLIC_STORE_NAME="ClickCart"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# Optional Stripe Integration (Behind env flag)
ENABLE_STRIPE="false"
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
